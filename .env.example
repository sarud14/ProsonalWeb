# Dev server — Next.js reads PORT automatically; NEXTAUTH_URL is derived as APP_HOST:PORT
PORT="3000"
APP_HOST="http://localhost"

DATABASE_URL=""
DIRECT_URL=""
NEXTAUTH_SECRET=""
# Optional override — leave empty to use APP_HOST:PORT
NEXTAUTH_URL=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Comma-separated allowlists for admin sign-in (required in production).
AUTH_ADMIN_EMAIL_ALLOWLIST=""
# Optional GitHub fallback when account email is private; use provider account IDs.
AUTH_ADMIN_GITHUB_ID_ALLOWLIST=""
CONTENT_SOURCE="mdx"
BLOB_READ_WRITE_TOKEN=""
